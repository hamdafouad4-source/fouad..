from abc import ABC, abstractmethod

class product(ABC):

    def __init__(self,id_number,name,price,stock) :
        self.__id_number = id_number
        self.__name = name
        self.set_price(price)
        self.set_stock(stock)

    def get_id_number(self):
        return self.__id_number

    def get_name(self):
        return self.__name

    def get_price(self):
        return self.__price

    def get_stock(self):
        return self.__stock

    

    def set_price(self,price):
        if price < 0:
            print ("Error: negative price.")
        else:
            self.__price = price

    def set_stock(self,stock):
        if stock < 0:
            print ("Error: negative number.")
        else:
            self.__stock = stock

    def reduce_stock (self,quantity):

        if quantity <= self.__stock:
            self.__stock -= quantity
        elif  quantity ==0 :
            print (" wait for thr restock")

    @abstractmethod
    def apply_discount(self):
        pass

    @abstractmethod
    def display_info(self):
        pass

class physical_product(product):
    def __init__(self,id_number,name,price,stock,shipping_cost) :
        super().__init__(id_number,name,price,stock)
        self.shipping_cost= shipping_cost

    def apply_discount(self) :
        discount = self.get_price() * 0.1
        self.set_price(self.get_price() - discount)
        return self.get_price()

    def display_info(self):
        print(f"""ID: {self.get_id_number()}
          type : physical product
         Name: {self.get_name()}
        Price: {self.get_price()}
       Stock: {self.get_stock()}
      Shipping Cost: {self.shipping_cost}$""")


class digital_product(product):
    def __init__(self,id_number,name,price,stock,download_link) :
        super().__init__(id_number,name,price,stock)
        self.download_link= download_link

    def apply_discount(self) :
        discount = self.get_price() * 0.1
