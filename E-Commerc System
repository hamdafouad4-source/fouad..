    def display_info(self):
        print(f"""ID: {self.get_id_number()}
            type : digital product
         Name: {self.get_name()}
        Price: {self.get_price()}
       Stock: {self.get_stock()}
       """)
class shopping_cart:
    def __init__(self) :
        self.cart_items= []
    def add_item (self,product):
        if product.get_stock() > 0:
         self.cart_items.append(product)
         product.reduce_stock(1)
         print (f"Added {product.get_name()} to the cart.")
        else :
            print (f"Sorry, {product.get_name()} is out of stock, wait for thr restock ")

    def view_cart(self):
        if not self.cart_items:
            print("Your cart is empty,Add items and they will appear here")
        else:
            print("Items in your cart:")
            for item in self.cart_items:
                print(f"- {item.get_name()} (${item.get_price()})")

    def checkout (self):
        if not self.cart_items:
            print("Your cart is empty,Add items and they will appear here")
            return 0 
        else:
            total = sum(item.get_price() for item in self.cart_items)
            print(f"Total amount: ${total}")
            print("Thank you for your purchase!")
            
 


products = [
    physical_product (1, "Laptop", 1000, 5, 25),
    physical_product (2, "Headphones", 200, 10, 10),
    digital_product (3, "Python Course", 100, 20, "link"),
    digital_product (4, "E-Book", 50, 15, "link")
]

def display_products(products):
    print ("Available Products \n")
    for product in products:
        product.display_info()
        print("----------------------------")

cart = shopping_cart()

while True:

    print("""
-------------- Smart E-Commerce System--------------
1. View Products
2. Add Product to Cart
3. View Cart
4. Checkout
5. Exit
------------------------------------------------
""")
 
   
    try:

        choice = int(input("Enter your choice: "))

        
        if choice == 1:
            display_products(products)


        elif choice == 2:

            product_input = input(
                "Enter Product ID or Product Name: ").strip()

            found = False

            for product in products:

                if (str(product.get_id_number()) == product_input
                   or
                        product.get_name().lower() == product_input.lower()):

                    cart.add_item(product)
                    found = True
                    break

            if not found:
                print("Product not found.")

        elif choice == 3:
            cart.view_cart()

        elif choice == 4:
            cart.checkout()

        elif choice == 5:
            print("Thank you for using the system. Goodbye!")
            break

        else:
            print("ERROR. Please enter a number from 1 to 5.")

    except ValueError:
            print("ERROR. Please enter a valid number.")
